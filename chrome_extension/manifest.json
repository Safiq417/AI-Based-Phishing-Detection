{
  "manifest_version": 3,
  "name": "PhishShield AI Protector",
  "version": "1.0",
  "description": "Real-time AI-based phishing detection powered by PhishShield.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://ai-based-phishing-detection-el4j.onrender.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with PhishShield"
  }
}
